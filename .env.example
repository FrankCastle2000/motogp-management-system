# 复制本文件为 .env，并按本机环境填写。不要提交真实的 .env。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=motogp_db

SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-password

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

OPERATION_LOG_RETENTION_DAYS=365
OPERATION_LOG_MAX_ROWS=10000
MOTOGP_API_BASE_URL=https://api.pulselive.motogp.com/motogp
MOTOGP_SYNC_COOLDOWN_SECONDS=3600
MOTOGP_RACE_RESULTS_SYNC_COOLDOWN_SECONDS=3600
MOTOGP_SYNC_TIMEOUT_SECONDS=12
